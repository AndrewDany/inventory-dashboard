# Copy this file to .env.local for local development. Never commit .env or .env.local.

# Required — Supabase project credentials
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — local PHP API database settings. These override
# api/config/db_config.php when provided.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=inventory_db
# DB_USER=root
# DB_PASS=

# Optional — powers the "Try Live Demo" button on the landing page.
# Leave unset to hide the demo button entirely.
# Use a dedicated demo account with a unique, disposable password. These values
# are bundled into client-side JavaScript and are therefore effectively public.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
