From df9ee5c5110b7c9b0bf1684d78700b4c92dc2608 Mon Sep 17 00:00:00 2001
From: Andrews Danyo <andrews@local>
Date: Mon, 21 Sep 2026 04:39:06 +0000
Subject: [PATCH 3/4] Fix critical bug: fulfillment_method NULL constraint
 violation on every regular sales order

Introduced in the Pre-Orders commit: the ternary re-accessed
$input['fulfillment_method'] directly in its true branch, skipping
the ?? 'pickup' fallback used in the condition check. Any sales order
that omits this field (i.e. every regular, non-pre-order sale) hit
an undefined-array-key warning and inserted NULL, violating the
column's NOT NULL constraint and failing outright. This broke the
entire Sales Orders feature, not just Pre-Orders. Fixed by computing
the default once and validating it, instead of accessing the input
array twice with inconsistent fallback behavior.
---
 api/routes/sales_orders.php | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/api/routes/sales_orders.php b/api/routes/sales_orders.php
index eb4be92..932f124 100644
--- a/api/routes/sales_orders.php
+++ b/api/routes/sales_orders.php
@@ -180,8 +180,10 @@ function handleSalesOrderRoutes(PDO $pdo, string $method, array $uriParts): void
         $customerName = $input['customer_name'] ?? null;
         $customerPhone = $input['customer_phone'] ?? null;
         $isPreorder = !empty($input['is_preorder']) ? 1 : 0;
-        $fulfillmentMethod = in_array($input['fulfillment_method'] ?? 'pickup', ['pickup', 'delivery'], true)
-            ? $input['fulfillment_method'] : 'pickup';
+        $fulfillmentMethod = $input['fulfillment_method'] ?? 'pickup';
+        if (!in_array($fulfillmentMethod, ['pickup', 'delivery'], true)) {
+            $fulfillmentMethod = 'pickup';
+        }
         $deliveryAddress = $input['delivery_address'] ?? null;
         $depositAmount = (float)($input['deposit_amount'] ?? 0);
         $items = $input['items'] ?? [];
